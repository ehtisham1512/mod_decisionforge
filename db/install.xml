<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/decisionforge/db" VERSION="2026081203" COMMENT="XMLDB file for mod_decisionforge"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
  <TABLES>
    <TABLE NAME="decisionforge" COMMENT="Decision Forge activity configuration">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="instructions" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="instructionsformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="experiencemode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="quick"/>
        <FIELD NAME="missionlabel" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT="Live decision simulation"/>
        <FIELD NAME="timeopen" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeclose" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timelimit" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="attemptsallowed" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="grade" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="true" DEFAULT="100"/>
        <FIELD NAME="gradepass" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="grademethod" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="highest"/>
        <FIELD NAME="feedbackmode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="immediate"/>
        <FIELD NAME="shufflecases" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="shuffleanswers" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="showprogress" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="requirejustification" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="requireconfidence" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="initialsafety" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="72"/>
        <FIELD NAME="initialcompliance" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="68"/>
        <FIELD NAME="initialtrust" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="74"/>
        <FIELD NAME="initialresources" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="80"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="decisionforge_cases" COMMENT="Cases belonging to an activity">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="decisionforgeid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="scenario" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="scenarioformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="questiontext" TYPE="char" LENGTH="500" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="points" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="true" DEFAULT="10"/>
        <FIELD NAME="position" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="active" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="archived" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="activity" TYPE="foreign" FIELDS="decisionforgeid" REFTABLE="decisionforge" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="activityposition" UNIQUE="false" FIELDS="decisionforgeid, position"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="decisionforge_options" COMMENT="Decision options for each case">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="caseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="optiontext" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="optiontextformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="score" TYPE="number" LENGTH="10" DECIMALS="5" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="consequence" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="consequenceformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="position" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="case" TYPE="foreign" FIELDS="caseid" REFTABLE="decisionforge_cases" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="caseposition" UNIQUE="false" FIELDS="caseid, position"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="decisionforge_attempts" COMMENT="Learner attempts">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="decisionforgeid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="attemptnumber" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1"/>
        <FIELD NAME="state" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="inprogress"/>
        <FIELD NAME="mode" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="quick"/>
        <FIELD NAME="currentcase" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="currentstageid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="snapshotjson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="pathjson" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="rawscore" TYPE="number" LENGTH="12" DECIMALS="5" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="possiblepoints" TYPE="number" LENGTH="12" DECIMALS="5" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="finalgrade" TYPE="number" LENGTH="12" DECIMALS="5" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="safety" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="72"/>
        <FIELD NAME="compliance" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="68"/>
        <FIELD NAME="trust" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="74"/>
        <FIELD NAME="resources" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="80"/>
        <FIELD NAME="outcomecode" TYPE="char" LENGTH="50" NOTNULL="true" DEFAULT=""/>
        <FIELD NAME="timestart" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timefinish" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="activity" TYPE="foreign" FIELDS="decisionforgeid" REFTABLE="decisionforge" REFFIELDS="id"/>
        <KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="userattempt" UNIQUE="true" FIELDS="decisionforgeid, userid, attemptnumber"/>
        <INDEX NAME="activitystate" UNIQUE="false" FIELDS="decisionforgeid, state"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="decisionforge_attempt_cases" COMMENT="Stable case and option order for an attempt">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="caseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="caseposition" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="optionorder" TYPE="text" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="attempt" TYPE="foreign" FIELDS="attemptid" REFTABLE="decisionforge_attempts" REFFIELDS="id"/>
        <KEY NAME="case" TYPE="foreign" FIELDS="caseid" REFTABLE="decisionforge_cases" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="attemptposition" UNIQUE="true" FIELDS="attemptid, caseposition"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="decisionforge_responses" COMMENT="Learner responses to cases">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="caseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="optionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="justification" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="confidence" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="50"/>
        <FIELD NAME="score" TYPE="number" LENGTH="12" DECIMALS="5" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timeanswered" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="attempt" TYPE="foreign" FIELDS="attemptid" REFTABLE="decisionforge_attempts" REFFIELDS="id"/>
        <KEY NAME="case" TYPE="foreign" FIELDS="caseid" REFTABLE="decisionforge_cases" REFFIELDS="id"/>
        <KEY NAME="option" TYPE="foreign" FIELDS="optionid" REFTABLE="decisionforge_options" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="attemptcase" UNIQUE="true" FIELDS="attemptid, caseid"/>
      </INDEXES>
    </TABLE>
