        <FIELD NAME="complianceimpact" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="trustimpact" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0"/>
