        <FIELD NAME="consequence" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="safety" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="compliance" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="trust" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0"/>
